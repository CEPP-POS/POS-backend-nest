### Test print receipt with proper layout
POST http://localhost:3000/print
Content-Type: application/json

[
  {
    "text": "@M0*E1",
    "align": "left",
    "font": "A"
  },
  {
    "text": "ร้านกาแฟ",
    "align": "left",
    "font": "A"
  },
  {
    "text": "Coffee",
    "align": "left",
    "font": "A"
  },
  {
    "text": "Shop",
    "align": "left",
    "font": "A"
  },
  {
    "text": "*E0",
    "align": "left",
    "font": "A"
  },
  {
    "text": "------------------------",
    "align": "left",
    "font": "A"
  },
  {
    "text": "@P",
    "align": "left",
    "font": "A"
  },
  {
    "text": "เลขที่:",
    "align": "left",
    "font": "A",
    "newLine": false
  },
  {
    "text": "INV-2024-001",
    "align": "left",
    "font": "A"
  },
  {
    "text": "วันที่:",
    "align": "left",
    "font": "A",
    "newLine": false
  },
  {
    "text": "20/03/2024 15:30",
    "align": "left",
    "font": "A"
  },
  {
    "text": "------------------------",
    "align": "left",
    "font": "A"
  },
  {
    "text": "ลาเต้เย็น",
    "align": "left",
    "font": "A"
  },
  {
    "text": "1 x 60.00",
    "align": "left",
    "font": "A",
    "charSpacing": 1
  },
  {
    "text": "@P",
    "align": "left",
    "font": "A"
  },
  {
    "text": "------------------------",
    "align": "left",
    "font": "A"
  }
]

