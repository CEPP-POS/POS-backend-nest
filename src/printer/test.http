    "align": "center",
    "font": "A",
    "bold": true
  },
  {
    "text": "วันที่: 2024-03-20 15:30:00",
    "align": "left",
    "font": "B"
  },
  {
    "text": "เลขที่: INV-2024-001",
    "align": "left",
    "font": "B"
  },
  {
    "text": "--------------------------------",
    "align": "center"
  },
  {
    "text": "ลาเต้เย็น x 1          ฿60.00",
    "align": "left",
    "font": "A"
  },
  {
