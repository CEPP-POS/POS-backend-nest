### Create Order with QRCODE PAY
POST http://localhost:3000/employee/orders
Content-Type: application/json
owner_id: 1
branch_id:1
{
  "createOrderDto": {
    "order_date": "2025-03-03T08:00:00Z",
    "total_price": 100,
    "status": "รอทำ",
    "payment_method": "qr-code",
    "path_img": "https://image/payment",
    "cancel_status": null
  },
  "items": [
    {
      "menu_id": 1,
      "sweetness_id": 79,
      "size_id": 1,
      "add_on_id": [3,4],  
      "menu_type_id": 1,
      "quantity": 2,
      "price": 100
    }
  ]
}

### Create Order WITH CASH PAY
POST http://localhost:3000/employee/orders
Content-Type: application/json
owner_id: 1
branch_id: 3
{
  "createOrderDto": {
    "order_date": "2025-03-01T08:00:00Z",
    "total_price": 260,
    "queue_number": null,
    "status": "canceled",
    "payment_method": "cash",
    "cash_given": 500,
    "change": 240,
    "cancel_status": null
  },
  "items": [
    {
      "menu_id": 1,
      "sweetness_id": 1,
      "size_id": 1,
      "add_on_id": [],  
      "menu_type_id": 1,
      "quantity": 2,
      "price": 100
    }
  ]
}

### Get All Orders
GET http://localhost:3000/employee/orders
Content-Type: application/json
owner_id: 1
branch_id: 3


### Get Order by ID
GET http://localhost:3000/employee/orders/5

### Update Order
PATCH http://localhost:3000/employee/orders/10
Content-Type: application/json

{
  "status": "cancel"
}

### Delete Order
DELETE http://localhost:3000/employee/orders/1

## cancel order
PATCH http://localhost:3000/employee/orders/15/cancel
Content-Type: application/json
owner_id: 1
branch_id: 3
{
  "customer_name": "John Doe",
  "contact": "0812345678"
}

### Get Order Item 
GET http://localhost:3000/employee/orders/item

### complete order
PATCH http://localhost:3000/employee/orders/55/complete
Content-Type: application/json
owner_id: 1
branch_id: 1

### pay with cash
POST http://localhost:3000/employee/orders/1/cash
Content-Type: application/json
{
"total_amount": 345,
"cash_given": 500,
"change": 155,
"status": "cash",
"amount": 345
}