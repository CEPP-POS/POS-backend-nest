GET http://localhost:3000/employee/pause/menu


// * Get all ingredient and paused status
GET http://localhost:3000/employee/pause/ingredients


// * update ingredient and paused status
PATCH http://localhost:3000/employee/pause/ingredients
Content-Type: application/json
owner_id: 1
branch_id: 1
[
  {
    "ingredient_id": 1,
    "paused": true
  },
  {
    "ingredient_id": 3,
    "paused": false
  }
]


// * Get all menu and paused status
GET http://localhost:3000/employee/pause/menus

