      "update_id": 8,
      "quantity_in_stock": 2,
      "total_volume": 12,
      "net_volume": 150,
      "expiration_date": "2025-02-28"
    },
    {
      "update_id": 7,
      "quantity_in_stock": 4,
      "total_volume": 90,
      "net_volume": 67,
