branch_id: 6
{
  "usernameOrEmail": "charlie.white@example.com",
  "otp": "888977"
}

### 5. Owner รีเซ็ตรหัสผ่านใหม่
PATCH http://localhost:3000/owner/reset-password
Content-Type: application/json
owner_id: 6
branch_id: 6
{
  "email": "charlie.white@example.com",
  "newPassword": "SecureWhite123!"
}
