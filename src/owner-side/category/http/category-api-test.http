branch_id: d458dffa-855b-4040-afba-dbf97055a820
{
  "category_name": "กาแฟสด",
  "menu_id": ["d3f37e87-c67f-4e8c-8a0d-f2442fa9e4da"]
}


PATCH http://localhost:3000/owner/categories/cdc5b074-2a8f-4fc6-9b8a-93e1e4590c77
Content-Type: application/json
