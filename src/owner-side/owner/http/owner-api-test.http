### Owner อัปโหลดไฟล์ CSV
POST http://localhost:3000/owner/upload-csv
Content-Type: multipart/form-data; boundary=boundary

--boundary
Content-Disposition: form-data; name="file"; filename="owners.csv"
Content-Type: text/csv

< /Users/watcharapolyotadee/Development/POS/POS-backend-nest/src/uploads/owners.csv
--boundary--




###  Owner ตรวจสอบว่ามี Employee อย่างน้อย 1 คน
GET http://localhost:3000/owner/check-employees
Authorization: Bearer {{TOKEN}}

###  Owner ดูข้อมูลตัวเอง
GET http://localhost:3000/owner/profile
Authorization: Bearer {{TOKEN}}


### Dev only สร้าง employee ใหม่
POST http://localhost:3000/owner/create-employee-dev
Content-Type: application/json

{
  "email": "employee@gmail.com",
  "password": "EmployeePass123!",
  "manager_id": 2
}